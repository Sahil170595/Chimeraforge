{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Sahil170595/chimeraforge",
  "title": "ChimeraForge",
  "description": "Local-first LLM deployment planner: GPU/VRAM sizing, cost and latency, with provenance",
  "repository": {
    "url": "https://github.com/Sahil170595/Chimeraforge",
    "source": "github"
  },
  "version": "0.22.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "chimeraforge",
      "version": "0.22.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "chimeraforge[mcp]",
          "description": "Install ChimeraForge with the optional MCP server extra"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
